   14          float PID_Increase(PID *PID,float NowData,float Point)
   15          {
   16   1          PID->Error=Point-NowData;
   17   1          PID->Out_P=(PID->Error-PID->LastError);
   18   1          PID->Out_I=PID->Error;
   19   1      
   20   1          PID->Out_D=(PID->Error-2*PID->LastError+PID->PrevError);
   21   1      
   22   1          PID->PrevError=0.9*PID->LastError+0.1*PID->PrevError;
   23   1          PID->LastError=0.9*PID->Error+0.1*PID->LastError;
   24   1      
   25   1          PID->LastData=NowData;
   26   1          return(PID->Kp*PID->Out_P+PID->Ki*PID->Out_I+PID->Kd*PID->Out_D);
   27   1      }
